# Database connection (recommended: provided by orchestrator/database container)
# Prefer setting POSTGRES_URL directly. If you only have discrete parts, set all of:
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, POSTGRES_PORT
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# CORS: comma-separated list of allowed origins for the frontend (no trailing slash)
# Example: http://localhost:3000,https://your-frontend.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000
