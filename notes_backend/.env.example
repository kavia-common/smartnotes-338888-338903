# Required: SQLAlchemy async URL for Postgres
# Example (adjust host/port/user/pass/db):
# POSTGRES_URL=postgresql+psycopg://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=

# Optional: comma-separated allowed origins for CORS.
# If empty, backend uses ["*"] (development-friendly, but not recommended for production).
# Example:
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-site.example.com
CORS_ALLOW_ORIGINS=
